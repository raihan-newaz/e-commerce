{
  "name": "nix-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint server/src/modules/builder client/src/builder server/src/scripts/installBuilder.ts",
    "typecheck": "npm --prefix server run typecheck && npm --prefix client run typecheck && npm --prefix storefront run typecheck",
    "test:builder": "npm --prefix server run test:builder",
    "test:builder:e2e": "playwright test",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:storefront": "cd storefront && npm run build",
    "media:optimize:uploads": "node scripts/optimize-images.cjs server/uploads/media",
    "seed": "cd server && npm run prisma:seed",
    "build": "npm run build:client && npm run build:storefront && npm run build:server",
    "start": "node server/dist/server.js",
    "dev": "node scripts/dev.cjs",
    "test:unified": "node --test scripts/tests/*.test.cjs",
    "db:clone": "node scripts/clone-database.cjs",
    "audit:data": "node scripts/audit-data.cjs",
    "setup": "node scripts/install.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
