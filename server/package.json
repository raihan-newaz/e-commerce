{
  "name": "nix-oms-server",
  "version": "1.0.0",
  "description": "Enterprise Order Management System, Accounting, ERP, CRM & Logistics Backend",
  "main": "dist/server.js",
  "scripts": {
    "builder:install": "ts-node src/scripts/installBuilder.ts",
    "builder:install-thank-you": "ts-node src/scripts/installLandingThankYou.ts",
    "catalog:install-slugs": "ts-node src/scripts/installProductSlugs.ts",
    "landing:tune-borka-cta": "ts-node src/scripts/tuneBorkaStickyCta.ts",
    "catalog:add-borka-color-terms": "ts-node src/scripts/addBorkaColorTerms.ts",
    "test:catalog-edits": "ts-node src/scripts/verifyCatalogEdits.ts",
    "test:builder": "node --test --test-concurrency=1 -r ts-node/register src/modules/builder/tests/*.test.ts",
    "test:orders": "node --test --test-concurrency=1 -r ts-node/register src/modules/couriers/tests/*.test.ts src/modules/orders/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "security:encrypt-secrets": "ts-node src/scripts/encryptStoredSecrets.ts",
    "catalog:populate": "ts-node src/scripts/populateFashionCatalog.ts",
    "catalog:backfill-attributes": "ts-node src/scripts/backfillProductAttributes.ts",
    "attributes:backfill-storefront": "ts-node src/scripts/backfillAttributePresentation.ts",
    "couriers:sync-locations": "ts-node src/scripts/syncCourierLocations.ts",
    "messaging:seed-sms": "ts-node src/scripts/seedSmsTemplates.ts",
    "media:sync": "ts-node src/scripts/syncMediaAssets.ts",
    "test:audit": "node --test -r ts-node/register src/tests/audit.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.1",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
