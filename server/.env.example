NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL="mysql://nix_ecommerce_dev:CHANGE_ME@127.0.0.1:3306/nix_ecommerce_dev?connection_limit=5&pool_timeout=10&connect_timeout=5"
JWT_SECRET=SET_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Keep the original encryption key when importing encrypted integration settings.
DATA_ENCRYPTION_KEY=SET_OR_RETAIN_THE_EXISTING_ENCRYPTION_KEY
# Asterisk IVR integration. Keep these values in server/.env, never in source.
PBX_IVR_URL=
PBX_IVR_SECRET=
PBX_IVR_ENABLED=false
# WebPhone uses a dedicated, least-privilege SIP extension.
# Secure upstream used by the authenticated /ws-sip proxy (valid TLS certificate required).
PBX_SIP_UPSTREAM_URL=
PBX_WEBRTC_SIP_DOMAIN=
PBX_WEBRTC_EXTENSION=
PBX_WEBRTC_PASSWORD=
PBX_WEBRTC_CALLER_ID=
# Fail closed. Enable explicitly ONLY in the reviewed live environment.
INTEGRATIONS_ENABLED=false
